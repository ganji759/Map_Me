# ─────────────────────────────────────────────────────────────────────────────
# Hodari frontend (Next.js) environment. Copy to .env.local and fill in real
# values. NEVER commit .env.local. NEXT_PUBLIC_* vars are inlined into the
# browser bundle (public); everything else is server-only (keep secret).
# ─────────────────────────────────────────────────────────────────────────────

# ── Google Maps — THREE least-privilege keys (see SECURITY) ──────────────────
# Browser key — SHIPS IN THE JS BUNDLE, so it MUST be restricted:
#   • Application restriction: HTTP referrers = your prod domain + http://localhost:3000/*
#   • API restriction (only what the browser uses): Maps JavaScript API,
#     Map Tiles API (realistic 3D), Places API, Street View Static API,
#     Directions API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_browser_maps_key_here
#
# Server key — used by /api/directions + the place-photo proxy. Keep it SECRET
# (never exposed to the browser):
#   • Application restriction: none (Cloud Run egress IPs are dynamic)
#   • API restriction: Routes API, Places API, Maps Static API,
#     Street View Static API, Geocoding API
GOOGLE_MAPS_SERVER_KEY=your_server_maps_key_here
#
# (The third key — restricted to Maps Grounding Lite / mapstools — lives in the
#  AGENT env, not here. See agents/.env.example.)
#
# Optional: use Places API (New) for richer in-browser place details/photos.
# NEXT_PUBLIC_PLACES_API_NEW=1

# ── Backend (ADK agent) ──────────────────────────────────────────────────────
# ADK API server URL (local dev: http://localhost:8000)
ADK_BASE_URL=http://localhost:8000
ADK_APP_NAME=hodari
# Audience for the Google ID token the frontend mints to call a LOCKED agent
# endpoint (only needed once the agent is restricted to the frontend service
# account). In prod = the agent's run.app URL; leave unset for local dev.
# AGENT_AUDIENCE=https://hodari-agent-xxxxxxxx.us-central1.run.app

# ── MongoDB (auth, saved places, billing, chat history) ──────────────────────
# The client reads/writes Mongo through the MCP sidecar — start it first
# (see CLAUDE.md dev commands), which itself reads MONGODB_URI as
# MDB_MCP_CONNECTION_STRING.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=hodari
MONGODB_MCP_URL=http://localhost:3100/mcp

# ── Auth & sessions ──────────────────────────────────────────────────────────
# Signs the httpOnly session cookie AND encrypts secrets at rest (Google Calendar
# refresh tokens + server-side chat transcripts). Use a long random string, e.g.
#   openssl rand -hex 32     (or: python -c "import secrets;print(secrets.token_hex(32))")
# NEVER commit the real value; rotating it invalidates sessions + encrypted data.
HODARI_SESSION_SECRET=replace_with_a_long_random_secret
#
# Google OAuth 2.0 (sign-in + Google Calendar). Create a Web OAuth client and add
# <PUBLIC_BASE_URL>/api/auth/google/callback as an authorized redirect URI.
# Calendar sync also needs the calendar.events scope added to the consent screen.
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret
#
# Public origin used to build OAuth redirects (MUST be the real URL, not req.url,
# which is 0.0.0.0 behind the Cloud Run proxy). Local dev: http://localhost:3000.
PUBLIC_BASE_URL=http://localhost:3000

# ── Usage metering (guest / member limits) ───────────────────────────────────
# Free generations before the login wall / paywall. Tune without a code change.
# HODARI_GUEST_FREE=3      # guest (not logged in), metered by IP
# HODARI_FREE_DAILY=5      # signed-in member, per day
# Owner/staff accounts that bypass metering entirely (comma-separated emails).
# HODARI_UNLIMITED_EMAILS=you@example.com,teammate@example.com

# ── Billing (Stripe) — OPTIONAL; the free tier works without it ──────────────
# Until these are set, the paywall shows "payments not enabled". Price ids are
# not secret; the secret key + webhook secret are.
# STRIPE_SECRET_KEY=sk_test_or_live_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# STRIPE_PRICE_STARTER=price_xxx
# STRIPE_PRICE_EXPLORER=price_xxx
# STRIPE_PRICE_TOURNAMENT=price_xxx

# ── Voice (Gemini speech-to-text + text-to-speech) ──────────────────────────────
# Used ONLY by the server-side voice routes (/api/voice/transcribe + /api/voice/speak);
# credentials are never exposed to the browser. Pick ONE of the two paths below.
#
# Path 1 — Vertex AI (RECOMMENDED): billed through Google Cloud Billing, so it draws
# on your Cloud credits / the same project the agents already use. Auth is ADC
# (run once: gcloud auth application-default login). The AI Studio "prepay wallet"
# is NOT used here, so depleted AI Studio credits do not matter.
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=your_project_id_here
# Gemini 2.5 voice models are served regionally (NOT from "global"); keep a region:
GEMINI_VOICE_LOCATION=us-central1
#
# Path 2 — Developer API key (AI Studio). Has its own prepay wallet, separate from
# Cloud credits. Leave GOOGLE_GENAI_USE_VERTEXAI unset/false to use this.
# GEMINI_API_KEY=your_gemini_api_key_here
#
# Optional model/voice overrides (both paths):
# GEMINI_STT_MODEL=gemini-3.5-flash
# GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# GEMINI_TTS_VOICE=Kore   # other voices: Puck, Charon, Aoede, Fenrir, Leda, Orus, Zephyr
