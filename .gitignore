# ── Secrets and local config ──────────────────────────────────────────────────
# Never commit real credentials. Copy the .example files instead.
.env
.env.*
!.env.example
!*.env.example
!.env.local.example
!*.env.local.example
client/.env.local
client/.env*.local
agents/.env

# Real Cloud Run service configs hold your project id and image digests.
# Copy infra/cloudrun-*.example.yaml to the same name without ".example".
infra/cloudrun-agent.yaml
infra/cloudrun-frontend.yaml

# Service account keys
*.pem
*.p12
*-service-account*.json
gha-creds-*.json

# ── Dependencies and build output ─────────────────────────────────────────────
node_modules/
.next/
out/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# ── Test and dev artefacts ────────────────────────────────────────────────────
