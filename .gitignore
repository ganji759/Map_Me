*.png
*.jpg
*.jpeg
image*
# ...but shipped site assets are not screenshots
!client/public/**/*.png
!client/public/**/*.jpg
!client/public/**/*.jpeg
!client/public/**/*.svg
!docs/**/*.png

.playwright-mcp/
.demo_frames/
playwright-report/
test-results/
coverage/
.pytest_cache/
video_demo

# ── ADK runtime artefacts and logs ────────────────────────────────────────────
agents/.adk/
agents/hodari/.adk/
agents/hodari_probe_*.json
agents/mcp-*.txt
*.log
*.log.*
*.err

